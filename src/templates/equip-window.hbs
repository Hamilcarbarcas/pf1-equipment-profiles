{{#*inline "pepSlot"}}
<div class="pep-slot-row">
  <div class="pep-slot {{state}}{{#if selected}} selected{{/if}}{{#if locked}} locked{{/if}}{{#if missing}} missing{{/if}}"
       data-slot="{{key}}" data-action="selectSlot" data-drop="{{key}}" data-tooltip="{{tooltip}}"
       {{#if img}}draggable="true" data-drag="slot"{{/if}}>
    {{#if img}}<img src="{{img}}" alt="">
    {{else if (eq state "empty")}}<i class="fa-solid fa-ban pep-slot-glyph" inert></i>
    {{else}}<i class="fa-solid {{icon}} pep-slot-glyph" inert></i>{{/if}}
    {{#if missing}}<i class="fa-solid fa-triangle-exclamation pep-badge" inert></i>{{/if}}
    {{#if locked}}<i class="fa-solid fa-lock pep-badge" inert></i>{{/if}}
  </div>
  <span class="pep-caption {{state}}">{{caption}}</span>
  {{#if grip}}
  <button type="button" class="pep-grip" data-action="toggleHeld" {{#if grip.fixed}}disabled{{/if}}
          data-tooltip="PF1EP.Window.GripHint">{{grip.label}}</button>
  {{/if}}
</div>
{{/inline}}

<div class="pep-ew">
  <header class="pep-ew-header">
    <details class="pep-icon-picker">
      <summary data-tooltip="PF1EP.Window.Icon"><i class="{{draft.icon}}" inert></i></summary>
      <div class="pep-icon-grid">
        {{#each icons}}
        <button type="button" class="{{#if active}}active{{/if}}" data-action="pickIcon" data-icon="{{icon}}"><i class="{{icon}}" inert></i></button>
        {{/each}}
      </div>
    </details>
    <input type="text" name="name" value="{{draft.name}}" placeholder="{{localize "PF1EP.Window.NamePlaceholder"}}">
  </header>

  <div class="pep-ew-body">
    <section class="pep-doll">
      <div class="pep-col left">{{#each left}}{{> pepSlot}}{{/each}}</div>
      <div class="pep-center">
        <img class="pep-portrait" src="{{portrait}}" alt="">
        <div class="pep-hands">{{#each hands}}{{> pepSlot}}{{/each}}</div>
      </div>
      <div class="pep-col right">{{#each right}}{{> pepSlot}}{{/each}}</div>
    </section>

    <aside class="pep-items">
      <input type="search" class="pep-filter" value="{{filterText}}" placeholder="{{localize "PF1EP.Window.Filter"}}">
      <div class="pep-item-list">
        {{#each groups}}
        <div class="pep-group" {{#if hidden}}hidden{{/if}}>
          <h4>{{localize label}}</h4>
          {{#each items}}
          <div class="pep-item{{#if misfit}} misfit{{/if}}{{#if assigned}} assigned{{/if}}" data-item-id="{{id}}" data-uuid="{{uuid}}"
               data-name="{{name}}" data-action="assignItem" draggable="true" data-drag="item" {{#if hidden}}hidden{{/if}}>
            <img src="{{img}}" alt="">
            <span class="pep-item-name">{{name}}</span>
            {{#if equipped}}<i class="fa-solid fa-check pep-equipped" data-tooltip="PF1.Equipped" inert></i>{{/if}}
          </div>
          {{/each}}
        </div>
        {{/each}}
      </div>
    </aside>
  </div>

  <section class="pep-other{{#if otherSelected}} selected{{/if}}" data-drop="other">
    <h4 data-action="selectSlot" data-slot="other">{{localize "PF1EP.Window.Other"}}</h4>
    <div class="pep-other-grid">
      {{#each other}}
      <div class="pep-other-entry{{#if missing}} missing{{/if}}{{#unless equipped}} off{{/unless}}" draggable="true" data-drag="other" data-index="{{index}}" data-tooltip="{{name}}">
        {{#if img}}<img src="{{img}}" alt="">{{else}}<i class="fa-solid fa-triangle-exclamation" inert></i>{{/if}}
        <button type="button" class="pep-other-toggle" data-action="toggleOther" data-index="{{index}}"
                data-tooltip="{{#if equipped}}PF1EP.Window.OtherEquip{{else}}PF1EP.Window.OtherUnequip{{/if}}">
          <i class="fa-solid {{#if equipped}}fa-check{{else}}fa-xmark{{/if}}" inert></i>
        </button>
        <button type="button" class="pep-other-remove" data-action="removeOther" data-index="{{index}}" data-tooltip="PF1EP.Window.Remove">
          <i class="fa-solid fa-eraser" inert></i>
        </button>
      </div>
      {{else}}
      <p class="hint">{{localize "PF1EP.Window.OtherHint"}}</p>
      {{/each}}
    </div>
  </section>

  {{#if warnings.length}}
  <ul class="pep-warnings">
    {{#each warnings}}<li><i class="fa-solid fa-triangle-exclamation" inert></i> {{this}}</li>{{/each}}
  </ul>
  {{/if}}

  <footer class="pep-ew-footer">
    <button type="button" data-action="fromCurrent"><i class="fa-solid fa-user-check" inert></i> {{localize "PF1EP.Window.FromCurrent"}}</button>
    <button type="button" data-action="clear"><i class="fa-solid fa-eraser" inert></i> {{localize "PF1EP.Window.Clear"}}</button>
    {{#unless isNew}}
    <button type="button" data-action="remove"><i class="fa-solid fa-trash" inert></i> {{localize "PF1EP.Window.Delete"}}</button>
    {{/unless}}
    <button type="button" class="pep-save" data-action="save"><i class="fa-solid fa-floppy-disk" inert></i> {{localize "PF1EP.Window.Save"}}</button>
  </footer>
</div>
